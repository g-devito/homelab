# Least privilege: each container gets its own /config plus only the folders it
# already uses, under the same in-container paths. None of them can see
# Immich, Seafile, Radicale or other services' data.
x-common: &common
  restart: always
  # Stopped during backups, so their SQLite databases are copied at rest.
  labels:
    - "backup.manage=true"
  environment:
    - PUID=1000
    - PGID=1000
    - TZ=Europe/Rome

services:
  qbittorrent:
    <<: *common
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Rome
      - WEBUI_PORT=8080
    volumes:
      - /opt/homelab/qbittorrent/config:/config
      - {{ arr_stack_downloads_dir }}:/data/downloads
    ports:
      - "{{ arr_stack_lan_ip }}:8080:8080"

  prowlarr:
    <<: *common
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    volumes:
      - /opt/homelab/prowlarr/config:/config
    ports:
      - "{{ arr_stack_lan_ip }}:9696:9696"

  lidarr:
    <<: *common
    image: lscr.io/linuxserver/lidarr:latest
    container_name: lidarr
    volumes:
      - /opt/homelab/lidarr/config:/config
      - {{ arr_stack_downloads_dir }}:/data/downloads
      - {{ arr_stack_music_dir }}:/data/navidrome/music
    ports:
      - "{{ arr_stack_lan_ip }}:8686:8686"

  # Soulseek client. Soularr drives it; the downloads dir must be the same path
  # in slskd, Soularr and Lidarr, so Lidarr can import what slskd fetched.
  slskd:
    <<: *common
    image: slskd/slskd:latest
    container_name: slskd
    user: "1000:1000"
    environment:
      - TZ=Europe/Rome
      - SLSKD_SLSK_USERNAME={{ slskd_soulseek_username }}
      - SLSKD_SLSK_PASSWORD={{ slskd_soulseek_password }}
      - SLSKD_API_KEY=role=Administrator;cidr=172.16.0.0/12;{{ slskd_api_key }}
      - SLSKD_DOWNLOADS_DIR=/downloads
      - SLSKD_NO_AUTH=false
    volumes:
      - /opt/homelab/slskd:/app
      - {{ arr_stack_downloads_dir }}:/downloads
    ports:
      - "{{ arr_stack_lan_ip }}:5030:5030"
      # Soulseek peer port: forward it on the router for incoming transfers.
      - "50300:50300"

  # Periodically searches slskd for Lidarr's wanted albums and asks Lidarr to import.
  soularr:
    <<: *common
    image: mrusse08/soularr:latest
    container_name: soularr
    user: "1000:1000"
    environment:
      - TZ=Europe/Rome
      - SCRIPT_INTERVAL=300
      - WEBUI_ENABLED=false
    volumes:
      - /opt/homelab/soularr:/data
      - {{ arr_stack_downloads_dir }}:/downloads
    depends_on:
      - lidarr
      - slskd

  radarr:
    <<: *common
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    volumes:
      - /opt/homelab/radarr/config:/config
      - {{ arr_stack_downloads_dir }}:/data/downloads
    ports:
      - "{{ arr_stack_lan_ip }}:7878:7878"

  sonarr:
    <<: *common
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    volumes:
      - /opt/homelab/sonarr/config:/config
      - {{ arr_stack_downloads_dir }}:/data/downloads
    ports:
      - "{{ arr_stack_lan_ip }}:8989:8989"

  # Only used by Prowlarr over the internal network: no port on the host.
  flaresolverr:
    <<: *common
    image: flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - TZ=Europe/Rome
      - LOG_LEVEL=info

services:
  minecraft:
    image: {{ minecraft_image }}
    container_name: minecraft
    restart: unless-stopped
    mem_limit: {{ minecraft_memory_limit }}
    environment:
      - TZ=Europe/Rome
      - EULA={{ minecraft_eula | string | upper }}
      - TYPE=FABRIC
      - VERSION={{ minecraft_version }}
      - MEMORY={{ minecraft_memory }}
      - MOTD={{ minecraft_motd }}
      - MAX_PLAYERS={{ minecraft_max_players }}
      - DIFFICULTY={{ minecraft_difficulty }}
      - VIEW_DISTANCE={{ minecraft_view_distance }}
{% if minecraft_modrinth_projects | length > 0 %}
      - MODRINTH_PROJECTS={{ minecraft_modrinth_projects | join(',') }}
      # Mods dropped from the list are deleted from the data folder too.
      - REMOVE_OLD_MODS=true
{% endif %}
{% if minecraft_whitelist | length > 0 %}
      - ENABLE_WHITELIST=true
      - WHITELIST={{ minecraft_whitelist | join(',') }}
      - ENFORCE_WHITELIST=true
{% endif %}
    ports:
      - "{{ minecraft_port }}:25565"
    volumes:
      - {{ minecraft_dir }}/data:/data
    labels:
      # Stopped during backups so the world is copied at rest.
      - "backup.manage=true"

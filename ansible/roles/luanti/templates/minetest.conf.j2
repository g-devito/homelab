# Managed by Ansible. The image reads this file from main-config/.
server_name = {{ luanti_server_name }}
server_description = {{ luanti_server_description }}
motd = {{ luanti_motd }}
max_users = {{ luanti_max_users }}
# LAN only: not listed on the public server list.
server_announce = false
default_game = {{ luanti_game_id }}
# Players pick a name; the first login sets its password.
disallow_empty_password = true
{% if luanti_admin | length > 0 %}
# Administrator of the server: has every privilege.
name = {{ luanti_admin }}
{% endif %}

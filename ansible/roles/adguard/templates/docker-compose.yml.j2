# DNS for the whole LAN: no backup.manage label on purpose, a stopped resolver
# would cut name resolution for every device. The config comes from Ansible.
services:
  adguard:
    image: adguard/adguardhome:{{ adguard_version }}
    container_name: adguard
    restart: unless-stopped
    volumes:
      - {{ adguard_dir }}/conf:/opt/adguardhome/conf
      - {{ adguard_dir }}/work:/opt/adguardhome/work
    ports:
      - "{{ adguard_lan_ip }}:53:53/tcp"
      - "{{ adguard_lan_ip }}:53:53/udp"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.adguard.rule=Host(`{{ adguard_domain }}`)"
      - "traefik.http.routers.adguard.entrypoints=https"
      - "traefik.http.routers.adguard.tls.certresolver=letsencrypt"
      - "traefik.http.services.adguard.loadbalancer.server.port=3000"
      - "traefik.docker.network=traefik-proxy"
{% if adguard_allowed_ranges | length > 0 %}
      - "traefik.http.routers.adguard.middlewares=adguard-lan@docker"
      - "traefik.http.middlewares.adguard-lan.ipallowlist.sourcerange={{ adguard_allowed_ranges | join(',') }}"
{% endif %}
    networks:
      - traefik-proxy

networks:
  traefik-proxy:
    external: true

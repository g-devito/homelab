services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    user: "1000:1000"
    restart: always
    environment:
      - TZ=Europe/Rome
      - JELLYFIN_PublishedServerUrl=https://{{ jellyfin_server_hostname }}
    volumes:
      - {{ jellyfin_data_dir }}/config:/config
      - {{ jellyfin_data_dir }}/cache:/cache
      # Media stays read-only: Jellyfin never changes the files on the disk.
      - {{ jellyfin_media_dir }}:/media:ro
    ports:
      - "{{ jellyfin_lan_bind }}:8096"
    labels:
      - "backup.manage=true"
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`{{ jellyfin_server_hostname }}`)"
      - "traefik.http.routers.jellyfin.entrypoints=https"
      - "traefik.http.routers.jellyfin.tls.certresolver=letsencrypt"
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
      - "traefik.docker.network=traefik-proxy"
    networks:
      - traefik-proxy

networks:
  traefik-proxy:
    external: true

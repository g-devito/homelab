services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    user: "1000:1000"
    restart: always
    environment:
      - TZ=Europe/Rome
      - JELLYFIN_PublishedServerUrl=http://{{ jellyfin_lan_bind }}
    volumes:
      - {{ jellyfin_data_dir }}/config:/config
      - {{ jellyfin_data_dir }}/cache:/cache
      # Media stays read-only: Jellyfin never changes the files on the disk.
      # rslave: a disk (re)mounted after the container started still shows up here.
      - {{ jellyfin_media_dir }}:/media:ro,rslave
{% if jellyfin_media_mount.rc == 0 %}
      # Transcoding segments: the media disk, so they can never fill the root disk.
      - {{ jellyfin_transcode_dir }}:{{ jellyfin_transcode_container_dir }}:rslave
{% endif %}
    # Home use only: published on the LAN address, not routed through Traefik.
    ports:
      - "{{ jellyfin_lan_bind }}:8096"
    labels:
      - "backup.manage=true"

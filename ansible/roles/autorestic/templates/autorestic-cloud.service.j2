[Unit]
Description=Autorestic Cloud Sync (B2 Immutable)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/storage

[Service]
Type=oneshot
EnvironmentFile=/etc/autorestic/env

ExecStartPre=/bin/sh -c 'pgrep -x autorestic >/dev/null || printf "running: false\n" > /etc/autorestic/.autorestic.lock.yml'
ExecStartPre=-/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/{{ autorestic_hc_cloud_uuid }}/start
ExecStart=/usr/local/bin/autorestic -c /etc/autorestic/config.yaml exec -b cloud-b2 -- copy --from-repo /mnt/storage/backups
ExecStart=-/usr/local/bin/autorestic -c /etc/autorestic/config.yaml exec -b cloud-b2 -- forget --prune {{ autorestic_cloud_retention }}
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/{{ autorestic_hc_cloud_uuid }}
ExecStopPost=/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || journalctl -u %n -n 40 --no-pager | curl -fsS -m 10 --retry 3 -o /dev/null --data-binary @- https://hc-ping.com/{{ autorestic_hc_cloud_uuid }}/fail'

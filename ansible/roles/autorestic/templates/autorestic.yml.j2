version: 2

locations:
  homelab:
    from:
      - /opt/homelab
      # Traefik's ACME certificates: a restore must not re-request every cert.
      - /etc/traefik
    to:
      - local-vault
    options:
      backup:
        # Temporary download data: re-downloadable, large, not worth backup space.
        exclude:
          - /opt/homelab/downloads
    hooks:
      before:
        - "ids=$(docker ps -q --filter label=backup.manage=true); [ -n \"$ids\" ] && docker stop $ids || true"
      after:
        - "ids=$(docker ps -a -q --filter label=backup.manage=true); [ -n \"$ids\" ] && docker start $ids || true"

backends:
  local-vault:
    type: local
    path: /mnt/storage/backups
    key: "{{ autorestic_repo_pwd }}"

  # B2 through its S3 API: a delete only hides a file, so with Object Lock on
  # the bucket a compromised host cannot destroy the cloud copy.
  cloud-b2:
    type: s3
    path: "{{ autorestic_b2_s3_url }}"
    key: "{{ autorestic_repo_pwd }}"
    env:
      AWS_ACCESS_KEY_ID: "{{ autorestic_b2_id }}"
      AWS_SECRET_ACCESS_KEY: "{{ autorestic_b2_key }}"

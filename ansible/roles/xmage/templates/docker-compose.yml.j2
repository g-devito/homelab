services:
  xmage:
    image: {{ xmage_image }}
    container_name: xmage
    restart: unless-stopped
    mem_limit: {{ xmage_memory_limit }}
    working_dir: /xmage/mage-server
    command: ["sh", "/xmage/start.sh"]
    environment:
      - TZ=Europe/Rome
      - XMAGE_SERVER_ADDRESS={{ xmage_server_address }}
      - XMAGE_SERVER_NAME={{ xmage_server_name }}
      - XMAGE_PORT={{ xmage_port }}
      - XMAGE_SECONDARY_PORT={{ xmage_secondary_port }}
      - XMAGE_AUTHENTICATION={{ xmage_authentication | lower }}
      - XMAGE_MAX_SECONDS_IDLE={{ xmage_max_seconds_idle }}
      - XMAGE_MAX_GAME_THREADS={{ xmage_max_game_threads }}
      - XMAGE_MAX_AI_OPPONENTS={{ xmage_max_ai_opponents }}
      - XMAGE_JAVA_OPTS={{ xmage_java_opts }}
    network_mode: host
    volumes:
      - {{ xmage_dir }}/start.sh:/xmage/start.sh:ro
      - {{ xmage_dir }}/server:/xmage/mage-server
      - {{ xmage_dir }}/db:/xmage/mage-server/db
    labels:
      # Stopped during backups so its database is copied at rest.
      - "backup.manage=true"
